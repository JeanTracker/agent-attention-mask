# ==============================================================================
# AI Pipeline Step Configuration (pipeline.config.env)
# ==============================================================================
# 지원 에이전트: agy (Antigravity), codex (ChatGPT), claude (Claude Code)
# 모델명(MODEL): 비워둘 경우 각 CLI의 기본/기존 설정 모델을 사용합니다.
# 활성화(ENABLED): true / false
# ==============================================================================

# [Step 1] 전체 코드베이스 분석 및 구현 계획 수립
STEP1_ENABLED="true"
STEP1_AGENT="claude"           # agy | codex | claude
STEP1_MODEL=""                 # 예: claude-3-7-sonnet, 또는 비워둠(기본값)

# [Step 2] 1차 기획서 리뷰 및 거버넌스 검토
STEP2_ENABLED="true"
STEP2_AGENT="claude"           # agy | codex | claude
STEP2_MODEL=""                 # 예: claude-3-7-sonnet, 또는 비워둠(기본값)

# STEP2_ENABLED="true"
# STEP2_AGENT="codex"            # agy | codex | claude
# STEP2_MODEL="gpt-5.6-sol"      # 예: gpt-5.6-sol, 또는 비워둠(기본값)


# [Step 3] 자율 코드 작성 및 단위 테스트 (구현)
STEP3_ENABLED="true"
STEP3_AGENT="claude"           # agy | codex | claude
STEP3_MODEL=""                 # 예: claude-3-7-sonnet, 또는 비워둠(기본값)

# [Step 4] 코드 변경사항(Git Diff) 2차 리뷰
STEP4_ENABLED="true"
STEP4_AGENT="claude"           # agy | codex | claude
STEP4_MODEL=""                 # 예: claude-3-7-sonnet, 또는 비워둠(기본값)

# [Step 5] 전체 정합성 검사 및 최종 리팩토링/상태 갱신
STEP5_ENABLED="true"
STEP5_AGENT="claude"           # agy | codex | claude
STEP5_MODEL=""                 # 예: claude-3-7-sonnet, 또는 비워둠(기본값)

# STEP5_ENABLED="true"
# STEP5_AGENT="agy"              # agy | codex | claude
# STEP5_MODEL=""                 # 예: gemini-3.8-flash, 또는 비워둠(기본값)
